---
const links = [
	{ href: "/", label: "Accueil" },
	{ href: "/species-slider/", label: "Les 3 especes" },
];

const species = ["Adelie", "Chinstrap", "Gentoo"];
const currentSpecies = species.find((name) => Astro.url.pathname.includes(`/species/${name}/`));
---

<nav class="sticky top-0 z-10 border-b border-slate-200 bg-white" aria-label="Navigation principale">
	<div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-4">
		<a class="mr-auto text-lg font-bold text-slate-900" href="/">Penguins</a>
		{links.map(({ href, label }) => (
			<a
				class="rounded-md px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-sky-100 hover:text-sky-900"
				href={href}
				>{label}</a
			>
		))}
		<label class="flex items-center gap-2 text-sm font-semibold text-slate-700" for="species">
			<span>Espece</span>
			<select id="species" class="rounded-md border border-slate-300 bg-white px-3 py-2" aria-label="Choisir une espece">
				{species.map((name) => (
					<option value={name} selected={name === currentSpecies}>{name}</option>
				))}
			</select>
		</label>
	</div>
</nav>

<script>
	document.querySelector("#species")?.addEventListener("change", (event) => {
		const value = (event.target as HTMLSelectElement).value;
		location.pathname = `/species/${value}/`;
	});
</script>