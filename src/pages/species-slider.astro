---
import GraphicSpecies from "../components/GraphicSpecies.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<main class="mx-auto flex min-h-full max-w-6xl flex-col gap-8 px-4 py-8">
		<header class="flex flex-col gap-4">
			<a class="w-fit text-sm underline" href="/">Retour a l'accueil</a>
			<h1 class="text-3xl font-bold">Les especes de pingouins</h1>
			<label class="flex w-fit items-center gap-2 text-sm font-semibold text-slate-700" for="species-anchor">
				<span>Espece</span>
				<select id="species-anchor" class="rounded-md border border-slate-300 bg-white px-3 py-2" aria-label="Choisir une espece">
					<option value="adelie">Adelie</option>
					<option value="gentoo">Gentoo</option>
					<option value="chinstrap">Chinstrap</option>
				</select>
			</label>
		</header>

		<div class="flex snap-x snap-mandatory scroll-smooth overflow-x-auto rounded-lg border border-slate-300">
			<section id="adelie" class="item flex min-w-full snap-start flex-col gap-4 p-6" aria-label="Graphique Adelie">
				<GraphicSpecies species="Adelie" />
			</section>
			<section id="gentoo" class="item flex min-w-full snap-start flex-col gap-4 p-6" aria-label="Graphique Gentoo">
				<GraphicSpecies species="Gentoo" />
			</section>
			<section id="chinstrap" class="item flex min-w-full snap-start flex-col gap-4 p-6" aria-label="Graphique Chinstrap">
				<GraphicSpecies species="Chinstrap" />
			</section>
		</div>
	</main>
</Layout>

<script>
	const speciesSelect = document.querySelector("#species-anchor") as HTMLSelectElement | null;
	const items = document.querySelectorAll(".item");

	speciesSelect?.addEventListener("change", (event) => {
		const value = (event.target as HTMLSelectElement).value;
		location.hash = value;
	});

	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				const id = entry.target.getAttribute("id");

				if (entry.isIntersecting) {
					if (id && speciesSelect) {
						speciesSelect.value = id;
					}
				}
			});
		},
		{ threshold: 0.5 },
	);

	items.forEach((item) => {
		observer.observe(item);
	});
</script>